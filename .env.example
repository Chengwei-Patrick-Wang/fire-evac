# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Empty means gemini-2.5-flash. The team uses gemini-3.5-flash (newer flash models answered 503 "high demand").
GEMINI_MODEL=
# Optional: the model tried when GEMINI_MODEL is out of quota, busy or slow (comma-separated for several).
# Empty means gemini-2.5-flash. After it the client tries gemini-3.6-flash, gemini-3.7-flash and gemini-3.1-flash-lite.
GEMINI_FALLBACK_MODEL=
# gemini, claude or off (off: no model calls; the report card is the template and agents use the rules).
LLM_PROVIDER=gemini
# Only if LLM_PROVIDER=claude (and pip install anthropic). Never name it ANTHROPIC_API_KEY: Claude Code would bill that key instead of your plan.
APP_ANTHROPIC_API_KEY=
# Only if LLM_PROVIDER=claude. Empty means claude-sonnet-5-5.
CLAUDE_MODEL=
