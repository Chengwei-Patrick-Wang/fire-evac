# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Empty means gemini-2.5-flash. The team uses gemini-3.5-flash (newer flash models answered 503 "high demand").
GEMINI_MODEL=
# Optional: the model tried when GEMINI_MODEL is out of quota, busy or slow (comma-separated for several).
# Empty means gemini-2.5-flash. After it the client tries gemini-3.6-flash, gemini-3.7-flash and gemini-3.1-flash-lite.
GEMINI_FALLBACK_MODEL=
# gemini, claude or off (off: no model calls; the report card is the template and agents use the rules).
LLM_PROVIDER=gemini
# Only if LLM_PROVIDER=claude. Never name it ANTHROPIC_API_KEY: Claude Code would bill that key instead of your plan.
APP_ANTHROPIC_API_KEY=
# Only if LLM_PROVIDER=claude. Empty means claude-opus-5-5 (report cards with their AI summary, the tracer's first pass).
CLAUDE_MODEL=
# Only if LLM_PROVIDER=claude. Empty means claude-haiku-5-5 (evacuee decisions in the sim's llm and mixed brains).
CLAUDE_AGENT_MODEL=
# Only if LLM_PROVIDER=claude: the most one process spends on Claude calls, in dollars (usage x list price). Empty means 25.
# Past it every call returns None: report cards use the template, agents the rules. An API run counts in its own worker process.
CLAUDE_BUDGET_USD=
